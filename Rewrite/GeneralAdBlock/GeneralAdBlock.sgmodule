#!name=General AdBlock
#!desc=Unified module for website/app response scripts; each target uses a dedicated JS file
#!system=ios

[Script]
Bahamut = type=http-response, pattern=^https:\/\/api\.gamer\.com\.tw\/(?:mobile_app\/anime\/v\d\/(?:token|m3u8)|anime\/v\d\/video_src)\.php(?:\?.*)?$, requires-body=true, max-size=0, timeout=40, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/bahamut-adblock.js?v=1.1.0
Google = type=http-response, pattern=^https?:\/\/(www\.)?google\.[^\/]+\/search(?:\/.*)?(?:\?.*)?$, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/google-adblock.js?v=1.0.17
Manhuashe = type=http-response, pattern=^https?:\/\/comicapi\.manhuashe\.com\/v\d\/.+?$, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/manhuashe-adblock.js?v=1.0.2
mFood Request = type=http-request, pattern=^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_new_special_list|_list_suspend|_list_smart|bottom\/banner\/_list)|orgs\/banner\/advertisement\/(?:_get_banner_list|_get_advertisement_list|_activity_advertisement_list)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList|_get_pop_list)|market\/user_side\/banner\/_get_banner_list|market\/market\/zone\/_new-people-ad|activity\/activity\/topPop\/list|activity\/userActivity\/getPop)(?:\?.*)?$, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/mfood-adblock.js?v=1.5.1
mFood = type=http-response, pattern=^https:\/\/userside-api\.mfoodapp\.com\/(?:orgs\/basic\/banner\/(?:_list_spread-compress|_special_list|_new_special_list|_list_suspend|_list_smart|bottom\/banner\/_list)|orgs\/banner\/advertisement\/(?:_get_banner_list|_get_advertisement_list|_activity_advertisement_list)|market\/user_side\/pop\/(?:_comprehensive_pop_list|getGroupPopList|_get_pop_list)|market\/user_side\/banner\/_get_banner_list|market\/market\/zone\/_new-people-ad|activity\/activity\/topPop\/list|activity\/userActivity\/getPop)(?:\?.*)?$, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/mfood-adblock.js?v=1.5.1
Wikipedia = type=http-response, pattern=^https?:\/\/(?:zh\.wikipedia\.org\/w\/load\.php\?.*modules=ext\.gadget\.VariantAllyDialog(?:&.*)?|zh\.wikipedia\.org\/w\/api\.php\?.*page=Template(?:%3A|:)AdvancedSiteNotices(?:%2F|\/)ajax(?:&.*)?|meta\.wikimedia\.org\/w\/index\.php\?.*title=Special(?:%3A|:)BannerLoader(?:&.*)?)$, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/wikipedia-adblock.js?v=1.0.1
Yahoo Finance Request = type=http-request, pattern=^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js?v=1.0.0
Yahoo Finance = type=http-response, pattern=^https:\/\/config\.mobile\.yahoo\.com\/V3\/getconfig(?:\?.*)?$, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/GeneralAdBlock/yahoo-finance-adblock.js?v=1.0.0

[MITM]
hostname = %APPEND% *.manhuashe.com, api.gamer.com.tw, config.mobile.yahoo.com, meta.wikimedia.org, userside-api.mfoodapp.com, www.google.com, zh.wikipedia.org
