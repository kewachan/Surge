{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-lyrics-translate",
  "main": "youtube.lyrics.worker.js",
  "compatibility_date": "2026-09-30",
  "secrets": {
    "required": ["LYRICS_ACCESS_TOKEN"]
  },
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [{"binding": "LYRICS_QUEUE", "queue": "youtube-lyrics-translate"}],
    "consumers": [{"queue": "youtube-lyrics-translate", "max_batch_size": 3, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 2}]
  },
  "durable_objects": {
    "bindings": [{"name": "LYRICS_PREWARM", "class_name": "LyricsPrewarm"}]
  },
  "exports": {
    "LyricsPrewarm": {"type": "durable-object", "storage": "sqlite"}
  }
}
