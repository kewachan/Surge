#!name=Youtube Enhance
#!desc=Enhancements for YouTube and YouTube Music
#!arguments=Block Upload Button:true,Block Immersive Button:true,Block Shorts Button:false,Caption Translation Language:off,Lyrics Translation Language:zh-Hant,Lyrics Access Token:paste-token-here,Enable Debug Mode:false
#!arguments-desc=- Blocking options: [true, false] \n- Translation options: [language code, off] \n\n1. Language codes follow the Google Translate language codes. Use off to disable a translation feature.\n2. Lyrics translation displays the original and translated line together.\n3. Enter the privately shared Lyrics Access Token to enable AI lyric translation; without a valid token, lyrics use Google Translate directly.\n4. Enable debug mode to output additional logs.


[Rule]
DOMAIN,youtube-lyrics-translate.hmtw47cv7m.workers.dev,DIRECT
DOMAIN,translate.googleapis.com,DIRECT

[Script]
youtube.response.navigation = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/navigation\/resolve_url(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.navigation.response.js
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.response.js,argument="{"captionLang":"{{{Caption Translation Language}}}","blockUpload":{{{Block Upload Button}}},"blockImmersive":{{{Block Immersive Button}}},"blockShorts":{{{Block Shorts Button}}},"debug":{{{Enable Debug Mode}}}}"
youtube.lyrics = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/get_panel(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,timeout=10,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.lyrics.js?v=20261008-1,argument="{"lyricsLang":"{{{Lyrics Translation Language}}}","lyricsToken":"{{{Lyrics Access Token}}}","debug":{{{Enable Debug Mode}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.request.js,argument="{"captionLang":"{{{Caption Translation Language}}}"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.request.js
youtube.caption.request = type=http-request,pattern=^https:\/\/www\.youtube\.com\/api\/timedtext\?(?:[^&]*&)*tlang=[^&]+(?:&|$),timeout=10,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.caption.js?v=20261001-1
youtube.caption.response = type=http-response,pattern=^https:\/\/www\.youtube\.com\/api\/timedtext\?(?:[^&]*&)*(?:enhance_)?tlang=[^&]+(?:&|$),requires-body=1,max-size=-1,timeout=120,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Rewrite/Youtube/youtube.caption.js?v=20261001-1

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com
