#!name=Node Offline Monitor
#!desc=Alerts after confirmed proxy outages and resumptions
#!system=ios
#!arguments=Schedule:*/15 * * * *,TestURL:auto,WakeSystem:true,PauseFrom,PauseUntil
#!arguments-desc=Schedule: cron expression (default: every 15 minutes). TestURL: auto uses the profile test URL. WakeSystem: wake the system for scheduled checks.\n\nPauseFrom / PauseUntil: optional maintenance times in HH:mm, using device time. Leave both empty to disable; overnight windows are supported.

[Script]
Node Offline Monitor = type=cron, cronexp="{{{Schedule}}}", wake-system={{{WakeSystem}}}, timeout=180, ability=http-client-policy, script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/NodeOfflineMonitor/node-offline-monitor.js?v=1.7.0, argument="test_url={{{TestURL}}}&maintenance_start={{{PauseFrom}}}&maintenance_end_time={{{PauseUntil}}}"
