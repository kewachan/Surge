#!name=CTM Usage Info
#!desc=Displays usage and remaining full-speed balance for up to two CTM plans.
#!author=kewachan
#!homepage=https://github.com/kewachan/Surge
#!category=Tools
#!date=2026-11-10
#!version=1.1.2
#!arguments=Token:paste-token-here,Token 2:none,Refresh Interval:900,Timeout:8
#!arguments-desc=Token: Paste your CTM Authorization token; the Bearer prefix is optional.\n\nToken 2: Optional token for a second plan. Keep none to show one plan. Each account needs a valid token.\n\nRefresh Interval: Automatic update interval in seconds (900 = 15 minutes).\n\nTimeout: Request timeout per plan in seconds (1-15; default: 8).\n\nTap refresh for an immediate update.

[Script]
CTM Usage Info = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/CTMUsage/ctm-usage.js?v=1.0.8,argument="token={{{Token}}}&token2={{{Token 2}}}&timeout={{{Timeout}}}"

[Panel]
CTM Usage Info = title="Remaining: -- MB",content="Set your CTM token in the module parameters, then refresh.",script-name=CTM Usage Info,update-interval={{{Refresh Interval}}}
