#!name=Network Interface Info
#!desc=Displays daily traffic and sampled max speed for Wi-Fi and Cellular
#!category=Tools
#!date=2026-09-12
#!version=1.1.0
#!arguments=style:compact,update_interval:1,icon:wifi.router,icon_color:#6699FF
#!arguments-desc=Style: Use compact for grouped values or normal for one value per line.\n\nUpdate Interval: Panel refresh interval in seconds. Use 1 to refresh whenever the panel opens.\n\nIcon: SF Symbol name.\n\nIcon Color: Icon color in HEX format.

[Script]
Network Interface Info = type=generic,timeout=30,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/NetworkInterfaceInfo/network-interface-info.js?v=1.1.0,argument="mode=panel&style={{{style}}}&icon={{{icon}}}&icon_color={{{icon_color}}}"
Network Interface Sampler = type=cron,cronexp="5,15,25,35,45,55 * * * *",wake-system=false,timeout=30,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/NetworkInterfaceInfo/network-interface-info.js?v=1.1.0,argument="mode=sample"
Network Interface Daily Reset = type=cron,cronexp="0 0 * * *",wake-system=true,timeout=30,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/NetworkInterfaceInfo/network-interface-info.js?v=1.1.0,argument="mode=reset"

[Panel]
Network Interface Info = script-name=Network Interface Info,update-interval={{{update_interval}}}
