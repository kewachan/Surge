#!name=Network Info
#!desc=Displays the proxy country, provider, and public IPv4 address
#!homepage=https://github.com/kewachan/Surge
#!category=Tools
#!date=2026-10-26
#!version=1.1.4
#!arguments=Lookup URL:https://api-ipv4.ip.sb/ip,Timeout:5,Retries:1,Retry Delay:1,Refresh Interval:1
#!arguments-desc=Lookup URL: Service used to look up the public IPv4 address.\n\nTimeout: Request timeout in seconds.\n\nRetries: Attempts after a failed request.\n\nRetry Delay: Delay between retries, in seconds.\n\nRefresh Interval: Panel refresh interval in seconds. Use -1 for manual refresh or 1 to update when the panel opens.

[Script]
Network Info = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/NetworkInfo/network-info.js?v=1.1.0,argument="proxy_endpoint={{{Lookup URL}}}&timeout={{{Timeout}}}&retries={{{Retries}}}&retry_delay={{{Retry Delay}}}"

[Panel]
Network Info = script-name=Network Info,update-interval={{{Refresh Interval}}}
