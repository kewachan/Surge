#!name=Network Info
#!desc=Displays the proxy country, provider, and public IPv4 address
#!homepage=https://github.com/kewachan/Surge
#!category=Tools
#!date=2026-11-02
#!version=1.2.0
#!arguments=Lookup URL:https://api-ipv4.ip.sb/ip,Timeout:5,Retries:1,Retry Delay:1,Refresh Interval:1
#!arguments-desc=Lookup URL: Service used to look up the public IPv4 address for its route.\n\nTimeout: Request timeout in seconds (1–30).\n\nRetries: Attempts after a failed request (0–5), within a 110-second total limit.\n\nRetry Delay: Delay between retries, in seconds (0–10).\n\nRefresh Interval: Panel refresh interval in seconds. Use -1 for manual refresh or 1 to update when the panel opens.

[Script]
Network Info = type=generic,timeout=120,script-path=https://raw.githubusercontent.com/kewachan/Surge/main/Tools/NetworkInfo/network-info.js?v=1.2.0,argument="version=2&timeout={{{Timeout}}}&retries={{{Retries}}}&retry_delay={{{Retry Delay}}}&proxy_endpoint={{{Lookup URL}}}"

[Panel]
Network Info = script-name=Network Info,update-interval={{{Refresh Interval}}}
